module Ins_mem(
    input logic [31:0] a,
    output logic [31:0] rd);
    logic [31:0] RAM [0:63];
    integer i;
    initial begin
        for (i = 0; i < 64; i = i + 1)
            RAM[i] = 32'h00000013;
       
        // ADDI x1, x0, 5
        RAM[0] = 32'h00500093;
        // ADDI x2, x0, 10
        RAM[1] = 32'h00A00113;
        // ADD x3, x1, x2
        RAM[2] = 32'h002081B3;
        // SUB x4, x1, x2
        RAM[3] = 32'h40208233;
        // AND x5, x1, x2
        RAM[4] = 32'h0020F2B3;
        // OR x6, x1, x2
        RAM[5] = 32'h0020E333;
        // SW x3, 0(x0)
        RAM[6] = 32'h00302023;
        // LW x7, 0(x0)
        RAM[7] = 32'h00002383;
    end
    assign rd = RAM[a[31:2]];
endmodule
