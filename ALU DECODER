module alu_decoder(
    input logic [1:0] alu_op,
    input logic [2:0] funct3,
    input logic funct7b5,
    input logic [6:0] op,
    output logic [2:0] alu_control);
    always @(*) begin
        case (alu_op)
            // LW / SW / JAL
            2'b00:
                alu_control = 3'b000;

            // BEQ
            2'b01:
                alu_control = 3'b001;
            // R-type / I-type
            2'b10: begin
                case (funct3)
                    // ADD / SUB / ADDI
                    3'b000: begin
                        if (op == 7'b0010011)
                            alu_control = 3'b000;
                        else if (funct7b5)
                            alu_control = 3'b001;
                        else
                            alu_control = 3'b000;
                    end
                    // SLT
                    3'b010:
                        alu_control = 3'b110;
                    // XOR
                    3'b100:
                        alu_control = 3'b100;
                    // OR
                    3'b110:
                        alu_control = 3'b011;
                    // AND
                    3'b111:
                        alu_control = 3'b010;
                    default:
                        alu_control = 3'b000;
                endcase
            end
            default:
                alu_control = 3'b000;
        endcase
    end
endmodule
