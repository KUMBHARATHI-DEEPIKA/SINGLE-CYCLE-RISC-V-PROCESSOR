module datapath(
    input logic clk,rst,
    input logic [1:0] result_src,
    input logic mem_write,branch, alu_src,reg_write,jump,
    input logic [1:0] imm_src,
    input logic [2:0] alu_control,
    input logic [31:0] instr,read_data,
    output logic [31:0] pc,alu_result,write_data,
    output logic zero);

    logic [31:0] pc_next,pc_plus4, pc_target;
    logic [31:0] imm_ext;
    logic [31:0] rd1,rd2;
    logic [31:0] src_b;
    logic [31:0] alu_out, result;
    logic pc_src;
    // PC
    d_ff pc_register(.clk(clk),.rst(rst),.d(pc_next),.q(pc) );

    // PC + 4
    
    adder pc_adder(.a(pc),.b(32'd4),.y(pc_plus4));
    // REGISTER FILE
    
    reg_file rf(.clk(clk),.we3(reg_write),.a1(instr[19:15]),.a2(instr[24:20]),.a3(instr[11:7]),.wd3(result),.rd1(rd1),.rd2(rd2),.rd3());
    // IMMEDIATE
    extend extender(.instr(instr[31:7]),.imm_src(imm_src),.imm_ext(imm_ext));
    // ALU SOURCE MUX
    
    assign src_b = alu_src ? imm_ext : rd2;

    // ALU
    
    ALU alu_unit(.a(rd1),.b(src_b),.alu_control(alu_control),.alu_result(alu_out),.zero(zero));
    assign alu_result = alu_out;
    assign write_data = rd2;
    // BRANCH / JUMP TARGET
    
    adder target_adder(.a(pc),.b(imm_ext),.y(pc_target));
    // PC SOURCE

    assign pc_src = (branch & zero) | jump;

    // NEXT PC
    always @(*) begin

        if (pc_src)
            pc_next = pc_target;
        else
            pc_next = pc_plus4;

    end

    // WRITEBACK
    
    always @(*) begin
        case (result_src)
            // ALU
            2'b00:
                result = alu_out;
            // DATA MEMORY
            2'b01:
                result = read_data;
            // PC + 4
            2'b10:
                result = pc_plus4;
            default:
                result = 32'b0;
        endcase
    end
endmodule
